{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "declaration": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "packages/**/*.ts",
    "tsup.config.ts"
  ]
}
